{
  "version": 1,
  "prepared_at": "2026-09-29",
  "specification": "docs/superpowers/specs/2026-09-29-assistant-understanding.md",
  "baseline_commit": "9bcd32d",
  "purpose": "Independent held-out acceptance questions. Do not copy questions into retrieval examples before evaluation.",
  "evaluation_notes": [
    "Map equivalent new topic IDs by meaning before scoring; upload.format means JSON layout or template help.",
    "Run turns sequentially, passing the preceding signed context token and using one signed-in user per sequence.",
    "Start each case with empty conversation state. General cases use no current object; object cases use a synthetic accessible fixture with distinctive known metadata.",
    "Direct correct answers and focused clarifications must be reported separately. A generic category menu is not an acceptable clarification for a known-topic case.",
    "A clarification must expose the required relevant candidates; up to four candidates are allowed. Candidate ordering is unconstrained unless an ordinal follow-up uses the actual previous response order.",
    "Out-of-scope questions should not inherit prior object or FAQ topics. Replies remain in English.",
    "No question authorizes the assistant to mutate data, execute searches, inspect selected uploads, or contact anyone.",
    "This corpus checks user-visible semantics and one access-revocation sequence. Snapshot integrity, runtime network isolation, context expiry/tampering/user binding, unavailable-model fallback, model limits, error recovery and desktop layout still require dedicated technical verification.",
    "Expected facts are assertions about prepared content, not a requirement to synthesize a bespoke answer for each wording."
  ],
  "fixture_requirements": {
    "accessible_object": "Owned or authorized public/shared object with known title, identifier, phase_name, software, mechanical_BC and exportable numeric arrays. Retain an exact copy to verify no mutations.",
    "shared_private_object": "Another owner's private object explicitly shared with the viewer. For Q23 revoke that relation after turn 1, then keep the earlier signed token and object_id."
  },
